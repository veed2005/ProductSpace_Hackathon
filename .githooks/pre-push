#!/bin/sh
# Blocks direct pushes to main: push your branch and open a PR instead.
# Set ALLOW_MAIN_PUSH=1 to override.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ -z "$ALLOW_MAIN_PUSH" ]; then
    printf '\n✋ Don'"'"'t push straight to main. Push your branch and open a PR:\n   git push -u origin HEAD && gh pr create --fill\n\n' >&2
    exit 1
  fi
done
exit 0
