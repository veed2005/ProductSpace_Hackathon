# Copy to .env and fill in. Never commit .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Fast model for voice/text conversation turns (latency matters).
FORMLINE_FAST_MODEL=claude-haiku-4-5
# Stronger model for document understanding and form-schema generation.
FORMLINE_STRONG_MODEL=claude-opus-5-5
# Model for drafting a form's questions on upload. Empty = FORMLINE_STRONG_MODEL.
FORMLINE_INGEST_MODEL=

# --- OpenAI (used when ANTHROPIC_API_KEY is empty, or when FORMLINE_LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# "", "anthropic" or "openai". Empty: whichever key is set (Anthropic first).
FORMLINE_LLM_PROVIDER=
FORMLINE_OPENAI_FAST_MODEL=
FORMLINE_OPENAI_STRONG_MODEL=
# Browser-agent decisions. Empty: gpt-5.4-mini on OpenAI, the fast model on Anthropic.
FORMLINE_AGENT_MODEL=
# Reasoning effort for OpenAI reasoning models: none | minimal | low | medium (default low).
FORMLINE_OPENAI_REASONING=
# A screenshot of what the person sees goes to the model when they ask a question, after a failed step,
# or on a page with almost no text. Screenshots skip the extension's redaction; false turns them off.
FORMLINE_SCREENSHOTS=
# Also send a screenshot for nearly-empty pages even when FORMLINE_SCREENSHOTS is false.
FORMLINE_VISION_FALLBACK=

# --- Twilio (one number for voice, SMS, MMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15550000000
# Set to false only for local testing without real Twilio signatures.
TWILIO_VALIDATE_SIGNATURES=true
# Record calls for demo backup footage (the greeting says the call is recorded). Team phones only.
FORMLINE_RECORD_CALLS=false

# --- Server ---
# Public URL Twilio can reach (your ngrok https URL), no trailing slash.
PUBLIC_BASE_URL=https://example.ngrok-free.app
# Defaults to <repo>/data/formline.db and <repo>/data no matter where you run from.
# DATABASE_URL=sqlite:////absolute/path/formline.db
# DATA_DIR=/absolute/path/data
LOG_LEVEL=INFO
# Lets `scripts/simulate.py --server http://localhost:8000` drive the running server so the
# dashboard shows simulator conversations live. Keep false whenever ngrok is running.
FORMLINE_DEV_ENDPOINTS=false
# The dashboard only answers requests made on this machine, never through ngrok. Leave false.
FORMLINE_DASHBOARD_REMOTE=false
